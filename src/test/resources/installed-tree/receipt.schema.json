{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lockgraph.dev/schemas/installed-tree-oracle-receipt-v1.json",
  "title": "Lockgraph sampled installed-tree oracle receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "platform",
    "concurrency",
    "pressureClassifier",
    "classification",
    "familySummary",
    "fixtures"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "platform": { "enum": ["linux", "darwin", "win32"] },
    "concurrency": { "const": 1 },
    "pressureClassifier": { "const": "deferred" },
    "classification": { "$ref": "#/$defs/classification" },
    "familySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npm", "pnpm", "yarn-classic", "yarn-berry", "bun", "deno"],
      "properties": {
        "npm": { "$ref": "#/$defs/familyCount" },
        "pnpm": { "$ref": "#/$defs/familyCount" },
        "yarn-classic": { "$ref": "#/$defs/familyCount" },
        "yarn-berry": { "$ref": "#/$defs/familyCount" },
        "bun": { "$ref": "#/$defs/familyCount" },
        "deno": { "$ref": "#/$defs/familyCount" }
      }
    },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixtureReceipt" }
    }
  },
  "$defs": {
    "classification": {
      "enum": [
        "PASS",
        "PRODUCT_DEFECT",
        "QUALIFICATION_REGRESSION",
        "AMBIGUOUS_EXECUTION"
      ]
    },
    "qualificationReason": {
      "enum": [
        null,
        "BINARY_MISSING",
        "WRITER_MISMATCH",
        "COMPANION_MISSING",
        "PRIVATE_REGISTRY",
        "FIXTURE_UNREACHABLE",
        "FIXTURE_HASH_MISMATCH",
        "SOURCE_ONLINE_FAILED",
        "SOURCE_REWRITE",
        "SOURCE_OFFLINE_OPEN",
        "SOURCE_TREE_NONDETERMINISTIC",
        "SOURCE_REBUILD_FAILED"
      ]
    },
    "familyCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "qualified", "executed", "passed", "breadth"],
      "properties": {
        "requested": { "type": "integer", "minimum": 0 },
        "qualified": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "breadth": { "$ref": "#/$defs/familyBreadth" }
      }
    },
    "familyBreadth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generations", "repositories"],
      "properties": {
        "generations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "repositories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exitCode", "signal", "durationMs", "output"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "exitCode": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "durationMs": { "type": "number", "minimum": 0 },
        "output": { "type": "string" }
      }
    },
    "fixtureReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "format",
        "provenance",
        "certifies",
        "installedTree",
        "qualification",
        "classification",
        "tool",
        "source",
        "replay",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "enum": ["npm", "pnpm", "yarn-classic", "yarn-berry", "bun", "deno"] },
        "format": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "path"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        "certifies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["acceptance", "cache-closure", "tree-equivalence"] }
        },
        "installedTree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "enum": ["APPLICABLE", "N/A"] },
            "reason": { "enum": [null, "NO_PROJECT_TREE_SURFACE"] }
          }
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "enum": ["QUALIFIED", "REFUSED"] },
            "reason": { "$ref": "#/$defs/qualificationReason" }
          }
        },
        "classification": { "$ref": "#/$defs/classification" },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias", "version", "runtime"],
          "properties": {
            "alias": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "runtime": { "type": "string", "minLength": 1 }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "online",
            "offline",
            "treeDigests",
            "rebuild",
            "rebuildWorkDigest",
            "rebuildTreeDigest"
          ],
          "properties": {
            "online": { "$ref": "#/$defs/leg" },
            "offline": {
              "type": "array",
              "items": { "$ref": "#/$defs/leg" },
              "maxItems": 2
            },
            "treeDigests": {
              "type": "array",
              "items": { "type": "string" },
              "maxItems": 2
            },
            "rebuild": { "$ref": "#/$defs/leg" },
            "rebuildWorkDigest": { "type": ["string", "null"] },
            "rebuildTreeDigest": { "type": ["string", "null"] }
          }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversionDigest",
            "offline",
            "treeDigest",
            "rebuild",
            "rebuildWorkDigest",
            "rebuildTreeDigest"
          ],
          "properties": {
            "conversionDigest": { "type": ["string", "null"] },
            "offline": { "$ref": "#/$defs/leg" },
            "treeDigest": { "type": ["string", "null"] },
            "rebuild": { "$ref": "#/$defs/leg" },
            "rebuildWorkDigest": { "type": ["string", "null"] },
            "rebuildTreeDigest": { "type": ["string", "null"] }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nativeOutput", "treeDiff", "rebuildDiff", "networkAttempts"],
          "properties": {
            "nativeOutput": { "type": "string" },
            "treeDiff": { "type": "array", "items": { "type": "string" } },
            "rebuildDiff": { "type": "array", "items": { "type": "string" } },
            "networkAttempts": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
